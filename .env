# Pinned git SHAs for reproducibility
# Update these to benchmark different versions.
# Each images/<dir>/Dockerfile declares the ARGs it uses; scripts/images.sh passes
# only those as build args and hashes their values into the image tag.

UPLC_TURBO_REPO=https://github.com/pragma-org/uplc.git
UPLC_TURBO_SHA=39c82af9b23e2d611f1eac4a905b5e421c755631 # main 2026-10-09

PLUTIGO_REPO=https://github.com/blinklabs-io/plutigo.git
PLUTIGO_SHA=fcb4c036dd128837985a97ad0970dbc03f31497c # v0.1.10

BLAZE_REPO=https://github.com/butaneprotocol/blaze-cardano.git
BLAZE_SHA=28367d38e18103daf9da42abce227d06486eea87

OPSHIN_REPO=https://github.com/OpShin/uplc.git
OPSHIN_SHA=8216a056fa8eacace597b9a335174cc054c12bbe

HASKELL_REPO=https://github.com/IntersectMBO/plutus.git
HASKELL_SHA=318c729391d2af395970867964e5db7f58d8ff2a

SCALUS_REPO=https://github.com/scalus3/scalus.git
SCALUS_SHA=b836856a5b4e54cd40fe0aa5947922478e8f1237 # v1.4.0 (2026-10-20); the JIT module is built from this source
# Maven version of the Scalus core (org.scalus::scalus) for images/scalus; must be the release at SCALUS_SHA
SCALUS_VERSION=1.4.0

JULC_REPO=https://github.com/bloxbean/julc.git
JULC_SHA=b4686eec87eb7afb51b44e72d13d29a99306dd54

# Toolchain versions
RUST_VERSION=1.94
GO_VERSION=1.26
BUN_VERSION=1.3.10
NODE_VERSION=22
PYTHON_VERSION=3.14
GHC_VERSION=9.6.4
JDK_VERSION=21
JDK_SDK_VERSION=25.0.2-graal
SBT_VERSION=1.10.11

# --- aiken / aiken-wasm (images/aiken, images/aiken-wasm) ---
AIKEN_REPO=https://github.com/aiken-lang/aiken.git
AIKEN_SHA=bacbeb35fbc9f1db93cd2e1e93fb1d93053acb4a # v1.1.24
# aiken-wasm builds the uplc crate at AIKEN_WASM_SHA to WASM the way the npm package
# @lucid-evolution/uplc LUCID_UPLC_VERSION is built. The image build fails unless the
# package's uplc_build_info() reports the same rev. 0.4.0 is built from
# colll78/aiken@28e42883 = aiken main after v1.1.24 (incl. the unreleased CEK perf
# work) + PV11/PV12 fixes, not from AIKEN_SHA.
AIKEN_WASM_SHA=28e42883b9192d123406d9c8fb79cb2817e98b9c # colll78/aiken main 2026-10-15
LUCID_UPLC_VERSION=0.4.0
# lucid-evolution commit whose packages/uplc/rust/Cargo.lock is used (same
# packages/uplc content as the 0.4.0 release commit ed6e3876)
LUCID_EVOLUTION_SHA=ae579343fe173d33902c76ef76ac80228312428f

# scalus-js image (images/scalus-js): the scalus npm package, and the vitest of the blaze-v8 harness
SCALUS_JS_VERSION=1.4.0
VITEST_VERSION=4.0.18
