cabal-version: 3.0
name:          gate-ref
version:       0.1.0
synopsis:      Haskell reference ExUnits for the plutus-vm-benchmark correctness gate
build-type:    Simple

executable gate-ref
  main-is:          Main.hs
  default-language: Haskell2010
  ghc-options:      -O2 -Wall
  build-depends:
    , aeson
    , base
    , bytestring
    , directory
    , filepath
    , mtl
    , plutus-core
    , plutus-core:flat
    , plutus-ledger-api
